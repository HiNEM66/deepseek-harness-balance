{
  "name": "dsh-balance",
  "version": "1.1.1",
  "description": "DeepSeek API balance button for the dsh web GUI sidebar foot, with a settings page",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js",
    "test": "node tests/smoke.mjs"
  }
}
